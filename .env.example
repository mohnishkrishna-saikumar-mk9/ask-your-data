# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# Local PostgreSQL connection (admin user - used by loaders)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/askyourdata
# Optional: read-only URL used by the app (see scripts/create_readonly_role.sql).
# If empty, the app falls back to DATABASE_URL.
READONLY_DATABASE_URL=
# Password used by scripts/create_readonly_role.py when creating ayd_reader
READONLY_PASSWORD=

# LLM keys - fill only the providers you use
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OmniRoute (self-hosted OpenAI-compatible gateway). Models: omniroute:<model id from its /v1/models>
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Models are written as provider:model_id. Check each provider's docs for current IDs.
# Separate EMPTY database for pytest integration tests (they drop + reload tables).
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/askyourdata_test

LLM_DEFAULT_MODEL=groq:qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=gemini:gemini-3.5-flash-lite
EVAL_MODELS=groq:qwen/qwen3.8-27b

# Optional: shown as a button on the Overview page
GITHUB_URL=

# Public demo only: max questions per visitor session (0 = unlimited)
DEMO_MAX_QUESTIONS=0
